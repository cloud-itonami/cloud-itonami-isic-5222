{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; This port/harbor-support-services vertical is an OPERATIONS
 ;; COORDINATION actor (pilotage/towage/berth-assignment logging,
 ;; berth/tug/pilot scheduling proposals, navigation-safety-concern
 ;; flagging, navigation-aid/facility maintenance coordination) -- it
 ;; never itself holds navigation-safety authority (see
 ;; `portauthority.governor`'s `finalize-clearance-violations`: any
 ;; proposal to directly finalize a berth/navigation-safety clearance
 ;; is a hard, permanent block, and the closed op-allowlist contains no
 ;; such op in the first place). This repo is standalone (forkable
 ;; outside the workspace); the :local/root paths only resolve inside
 ;; the monorepo checkout -- a standalone fork should override them
 ;; with git coordinates.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        ;; jp-go-dds (デジタル庁デザインシステム) -- this workspace's BASE
        ;; design system. `jp-go-dds.skin/dds+skin` is the compat skin the
        ;; cloud-itonami operator consoles use: vendored dds.css + a skin
        ;; that styles plain semantic markup with DADS tokens only (no raw
        ;; hex, no second design system). Git coordinates, not :local/root,
        ;; so a standalone fork still resolves it.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        ;; shared langchain.db store seam (EDN-blob codec + identity
        ;; schema + field-spec entity helpers) -- this store is an
        ;; entity-store adopter (ADR-2607141600), NOT a hand-rolled
        ;; enc/dec* copy.
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "portauthority.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate
  ;; docs/samples/operator-console.html by really running the actor
  ;; (flagship checklist item 2, ADR-2607189300 Wave 6). Refuses to write
  ;; when the scenario produces zero governor holds.
  :render-html {:main-opts ["-m" "portauthority.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
